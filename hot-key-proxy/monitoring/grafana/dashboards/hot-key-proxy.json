        { "expr": "histogram_quantile(0.99, sum by (le) (rate(proxy_request_latency_seconds_bucket[1m])))", "legendFormat": "protected p99", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"origin-service\"}[1m])))", "legendFormat": "origin p99", "refId": "C" }
      ],
      "title": "Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
